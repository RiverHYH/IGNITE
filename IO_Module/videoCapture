import av
import numpy as np
import logging

# Purpose: Logging Machanism
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class CameraStream:
    """
    A Input Model that fetches video streaming.
    Args:
        device_name(str): The video input source.
        resolution(str,optional): Resolution of the streaming. Default as "1920*1080"
        fps(str,optional): Frame rate of the streaming. Default as "30"
    """
    def __init__(self, device_name:str, resolution:str="600x400", fps="30"):
        self.device_name = device_name
        self.options = {
            'video_size': resolution,
            'framerate': fps,
            'rtbufsize': '702000k',  # Purpose:Large buffer to prevent frame drops
            'probesize': '32',       # Purpose: Start stream faster
            'analyzeduration': '0'   # Purpose: Reduce initial lag
        }
        self.container = None

    def __enter__(self):
        """Context manager entry point."""
        self.start()
        return self

    def start(self):
        """Initializes the DirectShow connection."""
        try:
            self.container = av.open(
                self.device_name, 
                format='dshow', 
                options=self.options
            )
            logger.info(f"Connected to {self.device_name}")
        except Exception as e:
            logger.error(f"Failed to open capture card: {e}")
            raise

    def frames(self):
        """
        Generator yielding frames as NumPy arrays (RGB).
        """
        if not self.container:
            self.start()

        # Target the first video stream
        video_stream = self.container.streams.video[0]
        
        try:
            for frame in self.container.decode(video_stream):
                # Convert to RGB numpy array for AI processing
                yield frame.to_ndarray(format='rgb24')
        except av.AVError as e:
            logger.error(f"Stream interrupted: {e}")

    def stop(self):
        """Graceful shutdown of the hardware connection."""
        if self.container:
            self.container.close()
            logger.info("Hardware connection released.")

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit point."""
        self.stop()






