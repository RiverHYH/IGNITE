if __name__ == "__main__":
    import cv2 

    print("Starting test feed...")
    print("CRITICAL: Click the VIDEO WINDOW before pressing 'q' to quit.")
    # 1. Create the named window FIRST
    window_name = "Test Frame"
    cv2.namedWindow(window_name, cv2.WINDOW_NORMAL) 
    
    # 2. (Optional) Set a default size so it doesn't open full-screen
    cv2.resizeWindow(window_name, 960, 540)
    
    try:
        with CameraStream(device_name="video=UGREEN-25854") as stream:
            for frame in stream.frames():
                # Convert RGB (PyAV) to BGR (OpenCV)
                display_frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
                
                cv2.imshow(window_name, display_frame)
                
                # Increase waitKey to 10ms to give Windows more time to catch the event
                key = cv2.waitKey(10) & 0xFF
                if key == ord('q') or key == 27: # 'q' or ESC key
                    print("Quitting...")
                    break
                    
    except KeyboardInterrupt:
        print("Interrupted by user (Ctrl+C).")
    finally:
        # These two lines ensure the window actually disappears
        cv2.destroyAllWindows()
        cv2.waitKey(1) 
        print("Cleanup complete.")